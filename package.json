{
  "name": "repo-cleaner",
  "version": "2.1.0",
  "private": true,
  "description": "🧰 一键清理前端项目冗余：统一管理全局 node_modules、禁用 .next/.vite 缓存、清理 dist/build 垃圾。支持 Next.js / React / Vue / Vite，中文/英文双语菜单。",
  "homepage": "https://github.com/sutchan/RepoCleaner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sutchan/RepoCleaner.git"
  },
  "bugs": {
    "url": "https://github.com/sutchan/RepoCleaner/issues"
  },
  "keywords": [
    "windows",
    "batch",
    "node-modules",
    "cleanup-tool",
    "disk-cleaner",
    "nextjs",
    "react",
    "vue",
    "vite",
    "npm",
    "cache-cleaner",
    "developer-tools",
    "cli",
    "repository-maintenance"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "check:docs": "node scripts/check-doc-links.mjs"
  },
  "dependencies": {
    "@swc/helpers": "0.5.23",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
