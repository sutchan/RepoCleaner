# npm 误存缓存（出现在仓库根时忽略）
.npm-cache/
%USERPROFILE%/

# ── 临时文件与产物目录（唯一约定，见 CONTRIBUTING.md §3.2）──
# .tmp/：一次性脚本 / 探针 / 调试日志 / 中间产物；内容全忽略，会话结束即清
.tmp/*
!.tmp/.gitkeep
# reports/ 等：正式工具产物（审计报告 / 覆盖率 / 测试结果）
/reports/*
!/reports/.gitkeep
/coverage/
/playwright-report/
/test-results/

# 根目录临时产物兜底：禁止散落 .tmp-*.mjs / *.log / audit-*.json 等
*.log
*.tmp
*.out
/*.txt
audit-*.json
*-result.json
.tmp-*
*_tmp*
tmp-*

# 依赖与构建产物
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
bin/

# Next.js 自动生成（仓库根的历史跟踪文件不受本规则影响）
next-env.d.ts

# 环境/密钥
.env*

# 产品运行配置（含开发者本机 REPO_ROOT 路径，不入库；示例见 docs/config.example.ini）
config.ini

# 编辑器/系统
.DS_Store
desktop.ini

# IDE 数据
.codebuddy/
.next_backup_*
.tmp/
reports/
