{
  "name": "repo-cleaner-design-tokens",
  "version": "1.2.2",
  "description": "RepoCleaner prototype 设计令牌（与 DESIGN-SYSTEM.md §2 及 src/app/globals.css 的 CSS 变量一致）",
  "colors": {
    "background": { "light": "#ffffff", "dark": "#0a0a0b" },
    "foreground": { "light": "#0a0a0b", "dark": "#ededed" },
    "card": { "light": "#ffffff", "dark": "#161618" },
    "muted": { "light": "#f4f4f5", "dark": "#1c1c1f" },
    "mutedForeground": { "light": "#71717a", "dark": "#a1a1aa" },
    "border": { "light": "#e4e4e7", "dark": "#27272a" },
    "primary": { "light": "#10b981", "dark": "#10b981" },
    "primaryForeground": { "light": "#ffffff", "dark": "#052e22" },
    "destructive": { "light": "#ef4444", "dark": "#ef4444" },
    "success": { "light": "#22c55e", "dark": "#22c55e" },
    "warning": { "light": "#f59e0b", "dark": "#f59e0b" }
  },
  "typography": {
    "display": { "size": 48, "weight": 700, "lineHeight": 1.1 },
    "h1": { "size": 32, "weight": 700, "lineHeight": 1.2 },
    "h2": { "size": 24, "weight": 600, "lineHeight": 1.3 },
    "h3": { "size": 18, "weight": 600, "lineHeight": 1.4 },
    "body": { "size": 15, "weight": 400, "lineHeight": 1.6 },
    "small": { "size": 13, "weight": 400, "lineHeight": 1.5 },
    "code": { "size": 13, "weight": 500, "lineHeight": 1.5 }
  },
  "spacing": {
    "space-1": 4,
    "space-2": 8,
    "space-3": 12,
    "space-4": 16,
    "space-5": 20,
    "space-6": 24,
    "space-8": 32
  },
  "radius": {
    "card": 12,
    "button": 8,
    "badge": 9999
  },
  "motion": {
    "dur-fast": "150ms",
    "dur": "250ms",
    "easing": "cubic-bezier(0.4,0,0.2,1)"
  }
}
